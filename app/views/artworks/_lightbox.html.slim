/ The gallery's lightbox (lightbox_controller.js): a modal over the whole viewport with a slide
/ per artwork on the page. The slides sit in a strip that scroll-snaps, so swipes and trackpads
/ move between photos natively, and the buttons and arrow keys scroll it too. Links to the
/ neighboring pages end the strip, where going on reopens the lightbox on that page's nearest
/ photo. Info shows each photo's EXIF under it, and Share shares the photo's own page.
- edge_slide = "flex w-full shrink-0 snap-center snap-always items-center justify-center text-gray-400 hover:text-white"
dialog class="group size-full max-h-none max-w-none bg-black text-sm text-gray-300" aria-label="Photos" data-lightbox-target="dialog" data-action="close->lightbox#focusThumbnail close->lightbox#restoreLocation"
  .flex.size-full.flex-col
    .flex.min-h-0.flex-1.snap-x.snap-mandatory.overflow-x-auto class="[scrollbar-width:none]" data-lightbox-target="strip" data-action="scroll->lightbox#update"
      - if pagination.previous_page
        = link_to "‹ Newer photos", pagination_path(pagination.previous_page, anchor: "lightbox-last"), class: edge_slide, data: { lightbox_target: "previousPage" }
      - artworks.each do |artwork|
        - exif = exif_details(artwork)
        figure.flex.w-full.shrink-0.snap-center.snap-always.flex-col data-lightbox-target="slide"
          .flex.min-h-0.flex-1.items-center.justify-center.p-4 data-action="click->lightbox#closeOnBackdrop"
            = image_tag url_for(artwork.image.variant(:gallery)), alt: artwork_title(artwork), loading: "lazy", class: "max-h-full max-w-full"
          - if exif.any?
            figcaption class="hidden px-4 pb-2 group-data-info:block"
              dl.flex.flex-wrap.gap-x-6.gap-y-2
                - exif.each do |label, value|
                  div
                    dt.text-xs.text-gray-400 = label
                    dd.text-gray-100 = value
      - if pagination.next_page
        = link_to "Older photos ›", pagination_path(pagination.next_page, anchor: "lightbox-first"), class: edge_slide, data: { lightbox_target: "nextPage" }
    .grid.items-center.gap-2.px-2.pb-2 class="grid-cols-[1fr_auto_1fr]"
      .flex.gap-1
        button class="rounded px-2 py-1 hover:bg-white/10 hover:text-white aria-disabled:opacity-40 aria-disabled:hover:bg-transparent aria-pressed:bg-white/15 aria-pressed:text-white" type="button" aria-pressed="false" data-lightbox-target="info" data-action="lightbox#toggleInfo" Info
        button class="rounded px-2 py-1 hover:bg-white/10 hover:text-white" type="button" aria-live="polite" data-lightbox-target="share" data-action="lightbox#share" Share
      .flex.items-center.gap-1
        button class="rounded px-3 py-1 text-lg leading-none hover:bg-white/10 hover:text-white aria-disabled:opacity-30 aria-disabled:hover:bg-transparent" type="button" aria-label="Previous photo" data-lightbox-target="previous" data-action="lightbox#previous" ‹
        span.min-w-14.text-center.tabular-nums aria-live="polite" data-lightbox-target="counter"
        button class="rounded px-3 py-1 text-lg leading-none hover:bg-white/10 hover:text-white aria-disabled:opacity-30 aria-disabled:hover:bg-transparent" type="button" aria-label="Next photo" autofocus=true data-lightbox-target="next" data-action="lightbox#next" ›
      form.justify-self-end method="dialog"
        button class="rounded px-2 py-1 hover:bg-white/10 hover:text-white" Close
