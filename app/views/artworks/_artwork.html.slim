/ A thumbnail that opens the gallery's lightbox at its photo (see _lightbox), or the larger
/ variant on its own without JavaScript.
li.mb-2.break-inside-avoid
  = link_to url_for(artwork.image.variant(:gallery)), aria: { haspopup: "dialog" }, data: { action: "lightbox#open", lightbox_target: "link", lightbox_index_param: artwork_counter } do
    = image_tag url_for(artwork.image.variant(:gallery_thumb)), alt: artwork_title(artwork), loading: "lazy", class: "w-full rounded"
