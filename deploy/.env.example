# Copy to deploy/.env on the Pi (it's gitignored) and fill in.

# The site's domain. Requests for any other host are refused (comma-separate several).
APP_HOST=

# The Cloudflare Tunnel's token: Zero Trust → Networks → Tunnels → the tunnel, the string
# after --token in its install command.
TUNNEL_TOKEN=

# SECRET_KEY_BASE is appended by deploy/bin/install. Keep it: it signs the variants' URLs,
# so a new one changes all of them.
